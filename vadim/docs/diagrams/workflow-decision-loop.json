  "cards": [
    {
      "dot": "cyan",
      "title": "SGR-петля",
      "items": [
        "Каждая итерация: наблюдение → контекст памяти → одно решение → одно действие",
        "Схема решения объявляется средой и проверяется до выполнения"
      ]
    },
    {
      "dot": "rose",
      "title": "Отказы",
      "items": [
        "Невалидная схема починяется и повторяется без потери шага",
        "409 RUN_BUSY означает очередь симулятора, а не ошибку агента"
      ]
    }
  ]
