# Default OpenAI provider
DECISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Codex defaults to gpt-5.6-terra with medium reasoning. Override the model here
# or use --model / --reasoning-effort. Install with `uv sync --extra codex` and
# complete `codex login` using the separately installed official Codex CLI on a trusted machine.
# For --decision-provider codex, leave OPENAI_API_KEY and CODEX_API_KEY unset.
# CODEX_MODEL=gpt-5.6-terra

SIMULATOR_URL=http://81.176.229.58:8080
# Current v2 deployments require this participant token for POST /v2/start.
# Keep it out of traces and logs.
SIMULATOR_PARTICIPANT_TOKEN=
